# CBIR Application Configuration
# Copy this file to .env and adjust paths for your system

# Dataset paths (relative to project root or absolute)
DATASET_B_OBJECTS_PATH=./data/Objects
DATASET_B_TEXTURES_PATH=./data/Textures
DATASET_A_PATH=./data/dataset_a

# Cache and storage
FEATURES_CACHE_DIR=./data/cache/features
INDEX_DIR=./data/cache/indexes
DB_PATH=./data/cbir.db

# Static file serving
STATIC_DIR=./data

# Search defaults
MAX_RESULTS=50
DEFAULT_COLOR_BINS=64
DEFAULT_LBP_POINTS=24
DEFAULT_LBP_RADIUS=3

# HOG parameters
DEFAULT_HOG_ORIENTATIONS=9

# Image preprocessing
IMAGE_RESIZE_W=256
IMAGE_RESIZE_H=256

# Logging
LOG_LEVEL=INFO
